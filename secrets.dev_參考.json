{
  // ════════════════════════════════════════════════════════════════
  // secrets.dev_參考.json — 機密設定範本
  // 本檔案展示了 secrets.dev.json 應有的結構。
  // 請複製此檔並改名為 secrets.dev.json，然後填入真實的機密資訊。
  // 注意：secrets.dev.json 已列入 .gitignore，請勿將其上傳。
  // ════════════════════════════════════════════════════════════════

  "ConnectionStrings": {
    // ── 主要資料庫 ─────────────────────────────────────────────────
    "MISContext":     "Data Source=<DB_IP>;Database=<DB_NAME>;User ID=<USER>;Password=<PWD>;TrustServerCertificate=true",
    "FEB_CMSContext": "Data Source=<DB_IP>;Database=<DB_NAME>;User ID=<USER>;Password=<PWD>;TrustServerCertificate=true",

    // ── DB 帳號清查（直連各 SQL 主機範例）────────────────────────────
    "AuditDbConnection_Prod_1": "Data Source=<DB_IP>;Database=master;User ID=<USER>;Password=<PWD>;TrustServerCertificate=true",
    "AuditDbConnection_Prod_2": "Data Source=<DB_IP>;Database=master;User ID=<USER>;Password=<PWD>;TrustServerCertificate=true",

    // ── 應用系統帳號清查（範例）─────────────────────────────
    "AuditAppConnection_Prod": "Data Source=<DB_IP>;Database=<DB_NAME>;User ID=<USER>;Password=<PWD>;TrustServerCertificate=true"
  },

  // ── LDAP / AD 連線 ────────────────────────────────────────────────
  "LdapConfig": {
    "Host":          "<LDAP_IP>",
    "BaseDC":        "DC=example,DC=com",
    "AdminBaseDC":   "CN=ServiceAccount,OU=Service,DC=example,DC=com",
    "AdminPassword": "<PASSWORD>"
  },

  // ── AD 控制器（密碼/建立帳號）────────────────────────────────────
  "AdControllerConfig": {
    "LdapUserDefaultPassword": "<DEFAULT_PWD>",
    "DirectAuthServiceAccount": {
      "DistinguishedName": "CN=EIPSys,OU=Service,DC=example,DC=com",
      "Password":          "<PASSWORD>"
    }
  },

  // ── VMware vCenter 帳號 ────────────────────────────────────────────
  "VMwareConfig": {
    "Environments": {
      "Production": { "Username": "user@example.com", "Password": "<PASSWORD>" },
      "Test":       { "Username": "user@example.com", "Password": "<PASSWORD>" }
    }
  },

  // ── VM 帳號清查（PowerShell Guest 帳號）──────────────────────────
  "VmAuditSettings": {
    "GuestUsername":        "DOMAIN\\user",
    "GuestPassword":        "<PASSWORD>"
  }
}
